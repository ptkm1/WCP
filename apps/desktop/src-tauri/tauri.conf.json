{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Work Context Platform",
  "version": "0.1.0",
  "identifier": "com.goker.wcp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Contexto de trabalho, identidade Git e tarefas",
    "longDescription": "Work Context Platform ajuda a alternar contexto entre empresas e repositorios, aplicar identidade Git e acompanhar tarefas.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Work Context Platform",
        "width": 1320,
        "height": 900,
        "resizable": true,
        "transparent": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ]
  }
}
